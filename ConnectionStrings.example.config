<?xml version="1.0" encoding="utf-8"?>
<connectionStrings>
  <add name="DnD_Trading.Properties.Settings.Online_LearningConnectionString"
       connectionString="Provider=Microsoft.ACE.OLEDB.12.0;Data Source=&quot;|DataDirectory|\Online Learning.mdb&quot;"
       providerName="System.Data.OleDb" />
  <add name="DnD_Trading.Properties.Settings.WstGrp22ConnectionString"
       connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=WstGrp22;Integrated Security=True"
       providerName="System.Data.SqlClient" />
</connectionStrings>
